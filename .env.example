# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string. Must be a replica set (MongoDB Atlas, or
# `npm run db:dev` locally) because gym creation uses transactions.
# Include a database name, e.g. ...mongodb.net/fittrack?... On Windows, if
# you get `querySrv ECONNREFUSED`, use Atlas' standard mongodb:// string.
MONGODB_URI=

# Auth.js secret used to sign/encrypt session tokens.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Set to true when running `next start` outside Vercel (e.g. locally or
# behind your own reverse proxy).
AUTH_TRUST_HOST=true

# Optional: password used by `npm run db:seed` for the fake development
# accounts. Defaults to a clearly-fake development password.
SEED_PASSWORD=
